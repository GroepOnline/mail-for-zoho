# Preferred: export the generated Zoho MCP endpoint directly from a secret store.
ZOHO_MCP_URL=REPLACE_FROM_ZOHO_MCP_CONSOLE

# Alternative: point the launcher at a protected regular file.
# That file must be mode 0600, must not be a symlink, and may contain only:
# ZOHO_MCP_URL=https://mcp.example.test/unique-endpoint
ZOHO_MCP_ENV=$HOME/.config/mail-for-zoho/env

# Profile mode (independent Zoho identities) does not read either variable above.
# Store one protected file per profile:
# $HOME/.config/mail-for-zoho/profiles/work/env
# $HOME/.config/mail-for-zoho/profiles/personal/env
# Each file contains one unquoted line:
# ZOHO_MCP_URL=https://mcp.example.test/unique-endpoint
